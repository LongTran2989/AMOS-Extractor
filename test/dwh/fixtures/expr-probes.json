{
  "about": "Engine-level proof of the converter's date and number rules (plan A.7 #7). Each probe is a table-free PostgreSQL query; `expected` is what AMOS and the DWH must both return (one value, or rows joined by |, NULL for a null). `ref` recomputes it in JavaScript.",
  "probes": [
    { "id": "month-minus-6-clamps", "pg": "SELECT DATE '2026-08-31' - INTERVAL '6' MONTH", "ref": { "fn": "addMonths", "args": ["2026-08-31", -6] }, "expected": "2026-02-28 00:00:00" },
    { "id": "month-plus-1-keeps-day", "pg": "SELECT DATE '2026-04-30' + INTERVAL '1' MONTH", "ref": { "fn": "addMonths", "args": ["2026-04-30", 1] }, "expected": "2026-05-30 00:00:00" },
    { "id": "month-plus-1-leap", "pg": "SELECT DATE '2028-01-31' + INTERVAL '1' MONTH", "ref": { "fn": "addMonths", "args": ["2028-01-31", 1] }, "expected": "2028-02-29 00:00:00" },
    { "id": "month-minus-6-mid", "pg": "SELECT DATE '2026-03-15' - INTERVAL '6' MONTH", "ref": { "fn": "addMonths", "args": ["2026-03-15", -6] }, "expected": "2025-09-15 00:00:00" },
    { "id": "month-plus-1-from-31-jan", "pg": "SELECT DATE '2026-01-31' + INTERVAL '1' MONTH", "ref": { "fn": "addMonths", "args": ["2026-01-31", 1] }, "expected": "2026-02-28 00:00:00" },
    { "id": "year-plus-1-from-leap-day", "pg": "SELECT DATE '2028-02-29' + INTERVAL '1' YEAR", "ref": { "fn": "addMonths", "args": ["2028-02-29", 12] }, "expected": "2029-02-28 00:00:00" },
    { "id": "minutes-on-a-date", "pg": "SELECT (DATE '1971-12-31' + 19680) + (COALESCE(615, 0) * INTERVAL '1 minute')", "ref": { "fn": "amosDateTime", "args": [19680, 615] }, "expected": "2025-11-17 10:15:00" },
    { "id": "minutes-last-of-day", "pg": "SELECT (DATE '1971-12-31' + 19680) + (COALESCE(1439, 0) * INTERVAL '1 minute')", "ref": { "fn": "amosDateTime", "args": [19680, 1439] }, "expected": "2025-11-17 23:59:00" },
    { "id": "minutes-null-is-midnight", "pg": "SELECT (DATE '1971-12-31' + 19680) + (COALESCE(NULL, 0) * INTERVAL '1 minute')", "ref": { "fn": "amosDateTime", "args": [19680, null] }, "expected": "2025-11-17 00:00:00" },
    { "id": "date-plus-days", "pg": "SELECT DATE '1971-12-31' + 20000", "ref": { "fn": "amosDate", "args": [20000] }, "expected": "2026-10-03" },
    { "id": "hours-chain-order", "pg": "SELECT TIMESTAMP '2026-11-17 20:30:00' + INTERVAL '7' HOUR - INTERVAL '24' HOUR", "ref": { "fn": "addHours", "args": ["2026-11-17 20:30:00", 7, -24] }, "expected": "2026-11-17 03:30:00" },
    { "id": "timestamp-to-date-next-day", "pg": "SELECT (TIMESTAMP '2026-11-17 23:59:59' + INTERVAL '7' HOUR)::date", "ref": { "fn": "toDate", "args": ["2026-11-17 23:59:59", 7] }, "expected": "2026-11-18" },
    { "id": "day-difference-year-boundary", "pg": "SELECT DATE '2027-01-02' - DATE '2026-12-30'", "ref": { "fn": "dayDiff", "args": ["2027-01-02", "2026-12-30"] }, "expected": "3" },
    { "id": "day-difference-leap", "pg": "SELECT DATE '2024-03-01' - DATE '2024-02-28'", "ref": { "fn": "dayDiff", "args": ["2024-03-01", "2024-02-28"] }, "expected": "2" },
    { "id": "day-difference-amos-epoch", "pg": "SELECT DATE '2026-11-17' - DATE '1971-12-31'", "ref": { "fn": "dayDiff", "args": ["2026-11-17", "1971-12-31"] }, "expected": "20045" },
    { "id": "int-division", "pg": "SELECT 7 / 2", "ref": { "fn": "intDiv", "args": [7, 2] }, "expected": "3" },
    { "id": "int-division-negative", "pg": "SELECT -7 / 2", "ref": { "fn": "intDiv", "args": [-7, 2] }, "expected": "-3" },
    { "id": "int-division-negative-divisor", "pg": "SELECT 7 / -2", "ref": { "fn": "intDiv", "args": [7, -2] }, "expected": "-3" },
    { "id": "modulo", "pg": "SELECT 7 % 3", "ref": { "fn": "mod", "args": [7, 3] }, "expected": "1" },
    { "id": "modulo-negative", "pg": "SELECT -7 % 3", "ref": { "fn": "mod", "args": [-7, 3] }, "expected": "-1" },
    { "id": "extract-day", "pg": "SELECT EXTRACT(DAY FROM DATE '2026-02-28')", "ref": { "fn": "extract", "args": ["DAY", "2026-02-28"] }, "expected": "28" },
    { "id": "extract-month", "pg": "SELECT EXTRACT(MONTH FROM DATE '2026-02-28')", "ref": { "fn": "extract", "args": ["MONTH", "2026-02-28"] }, "expected": "2" },
    { "id": "null-order-asc", "pg": "SELECT 2 UNION ALL SELECT NULL UNION ALL SELECT 1 ORDER BY 1", "ref": { "fn": "order", "args": [[2, null, 1], "asc"] }, "expected": "1|2|NULL" },
    { "id": "null-order-desc", "pg": "SELECT 2 UNION ALL SELECT NULL UNION ALL SELECT 1 ORDER BY 1 DESC", "ref": { "fn": "order", "args": [[2, null, 1], "desc"] }, "expected": "NULL|2|1" }
  ]
}
