{
  "name": "amos-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Logical schema (single source of truth) and tooling for extracting and validating AMOS MRO data.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "validate": "node src/cli.ts validate",
    "docs": "node src/cli.ts docs",
    "docs:check": "node src/cli.ts docs --check",
    "scaffold": "node src/cli.ts scaffold",
    "check": "npm run typecheck && npm test && npm run validate && npm run docs:check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "node-sql-parser": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
